@model LoginModel

@{
    ViewData["Title"] = "Ingresar";
}

<h1>Ingresar</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
}

<form asp-action="Login" method="post">
    <div class="mb-3">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" autocomplete="username" />
        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Contrasenia"></label>
        <input asp-for="Contrasenia" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Contrasenia" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Ingresar</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
