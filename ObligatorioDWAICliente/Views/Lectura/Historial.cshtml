@model HistorialModel

@{
    ViewData["Title"] = "Historial";
}

<h1>Historial de lecturas</h1>

<form asp-action="Historial" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Mes" class="form-label">Mes</label>
        <input asp-for="Mes" class="form-control" min="1" max="12" required />
    </div>
    <div class="col-auto">
        <label asp-for="Anio" class="form-label">Año</label>
        <input asp-for="Anio" class="form-control" min="1" max="9999" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info" role="status">@ViewBag.Mensaje</div>
}

@if (Model.Lecturas.Count > 0)
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Historia</th>
                    <th scope="col">Fecha de inicio</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Final alcanzado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lectura in Model.Lecturas)
                {
                    <tr>
                        <td>@lectura.TituloHistoria</td>
                        <td>@lectura.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@(lectura.Completada ? "Completada" : "En curso")</td>
                        <td>@(lectura.TituloFinalAlcanzado ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
