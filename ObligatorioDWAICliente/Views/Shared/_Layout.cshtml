@{
    bool modoOscuro = Context.Session.GetString("estiloLectura") == "oscuro";
    string tema = modoOscuro ? "dark" : "light";
    string siguienteEstilo = modoOscuro ? "claro" : "oscuro";
    string volverA = Context.Request.PathBase.Add(Context.Request.Path).ToString()
        + Context.Request.QueryString.ToString();
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="@tema">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ObligatorioDWAICliente</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Aventura</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("token")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lectura" asp-action="Index">Historias</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lectura" asp-action="Historial">Historial</a>
                            </li>
                            <li class="nav-item align-self-sm-center">
                                <form asp-controller="Lectura" asp-action="Estilo" method="post">
                                    <input type="hidden" name="volverA" value="@volverA" />
                                    <button type="submit" name="estilo" value="@siguienteEstilo" class="btn btn-outline-secondary btn-sm">
                                        Cambiar a modo @siguienteEstilo
                                    </button>
                                </form>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Aventura
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
